{
  "name": "l-code-pricing-engine",
  "version": "1.2.0",
  "private": true,
  "description": "L-Code Pricing Engine — desktop nástroj pro přepočet ceníků a přiřazení věrnostních tierů zákazníků",
  "author": "L-Code Dynamics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "publish:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.l-code-dynamics.pricing-engine",
    "productName": "L-Code Pricing Engine",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "lib/**/*",
      "assets/**/*",
      ".env"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "hlancaric-ship-it",
      "repo": "okfish-pricing-engine"
    }
  }
}
